/* header */
header .wrap { display:flex; flex-wrap:wrap; gap:.5rem 1.5rem; align-items:baseline; justify-content:space-between; padding-top:1.25rem; padding-bottom:1rem; }
.path { color:var(--muted); }
.path b { color:var(--ink); font-weight:700; }
/* hero */
.hero { display:grid; grid-template-columns:minmax(0,1fr) minmax(16rem,clamp(16rem,34vw,28rem)); align-items:center; gap:1.5rem 2rem; padding:3rem 0 1rem; }
.hero > div { min-width:0; }
h1 { font-weight:700; font-size:1.25rem; line-height:1.3; margin:0; }
.lede { margin:0; max-width:100%; color:var(--muted); }
.cursor { display:inline-block; width:.6em; height:1.05em; margin-left:.2em; background:var(--ink); vertical-align:-.2em; animation:blink 1.1s steps(1) infinite; }
@keyframes blink { 50% { opacity:0; } }
.sr { position:absolute; width:1px; height:1px; overflow:hidden; clip:rect(0 0 0 0); white-space:nowrap; }
@media (prefers-reduced-motion: reduce) { .cursor { animation:none; } }
.gif { margin:0; width:100%; max-width:100%; }
.gif img { display:block; width:100%; height:auto; object-fit:contain; }

/* sections */
section { padding:2rem 0 .25rem; }
h2 { font-weight:700; font-size:.875rem; margin:0 0 1rem; }
h2::before { content:"## "; color:var(--muted); font-weight:400; }
.about p { max-width:70ch; margin:0 0 1rem; }

/* records */
.rec { display:grid; grid-template-columns:18ch 1fr; gap:0 2ch; padding:0 0 .9rem; }
.group { padding:0 0 1.25rem; }
.group h3 { font-weight:700; font-size:inherit; margin:0 0 .2rem; }
.group .row { display:grid; grid-template-columns:18ch 1fr; gap:0 2ch; }
.group .row .when { color:var(--muted); }
.rec .when { color:var(--muted); }
.rec h3 { font-weight:400; font-size:inherit; margin:0; max-width:80ch; }
.rec h3 .translation { color:var(--muted); }
.rec .where { margin:0; color:var(--muted); max-width:80ch; }
.rec .note { margin:0; color:var(--muted); max-width:80ch; }
.meta { margin:0; padding:0; list-style:none; }
.meta li { display:inline; margin-right:1ch; color:var(--muted); }
.meta li::before { content:"["; }
.meta li::after { content:"]"; }
.meta li.act { color:var(--ink); }
.rec.todo * { color:var(--muted); }
@media (max-width:40rem) { .hero { grid-template-columns:1fr; } .gif { width:min(100%,28rem); justify-self:center; } }
@media (max-width:40rem) { .rec { grid-template-columns:1fr; } .group .row { grid-template-columns:12ch 1fr; gap:0 1ch; } .group .row.talk { grid-template-columns:1fr; } }

.group .where { display:block; color:var(--muted); }
.group .translation { color:var(--muted); }
.group .row > div { max-width:80ch; }
.group .row.talk + .row.talk { margin-top:.6rem; }

/* footer */
footer { margin-top:2rem; padding:1.5rem 0 3rem; color:var(--muted); }
footer .wrap > * { margin:0 0 .5rem; }
details summary { cursor:pointer; }
details ul { margin:.5rem 0 0; padding:0; list-style:none; }
details li span { margin-right:2ch; }

.controls { display:flex; align-items:center; gap:.5rem; }
.lang { font:inherit; color:var(--muted); border:0; background:transparent; padding:.1rem .2rem; cursor:pointer; }
.lang[aria-pressed="true"] { color:var(--ink); font-weight:700; text-decoration:underline; text-underline-offset:3px; }
.lang:hover { color:var(--ink); }
